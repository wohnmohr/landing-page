---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/elements/Navbar.astro";
import Footer from "../../components/elements/Footer.astro";
import PageHero from "../../components/ui/PageHero.astro";
import ProductShowcase from "../../components/home/ProductShowcase.astro";
import { products } from "../../utils/company";
---

<Layout
  title="Products | wohnmohr"
  description="Every product wohnmohr builds and runs: a growing suite of focused software, each one made for a single everyday job."
  breadcrumbs={[{ name: "Products", path: "/products/" }]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: products.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `https://wohnmohr.com/products/${p.slug}/`, name: p.name })),
  }}
>
  <Navbar />
  <main>
    <PageHero
      title="Products built for one job each."
      intro="Each one does a single everyday job well. Every product here is one we build and run ourselves, and more are on the way."
    />
    <div class="-mt-16 sm:-mt-20">
      <ProductShowcase showIntro={false} />
    </div>
  </main>
  <Footer />
</Layout>
