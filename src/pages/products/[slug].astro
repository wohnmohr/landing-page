---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/elements/Navbar.astro";
import Footer from "../../components/elements/Footer.astro";
import BtnLink from "../../components/shared/BtnLink.astro";
import Container from "../../components/shared/Container.astro";
import ProductFrame from "../../components/brand/ProductFrame.astro";
import { company, products, type Product } from "../../utils/company";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const other = products.filter((p) => p.slug !== product.slug);
const live = product.status === "Live";
const mobileFirst = product.device === "mobile";
const ctaExternal = product.ctaHref.startsWith("http");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: product.name,
  url: product.url,
  description: product.metaDescription,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  publisher: { "@id": `${company.url}/#organization` },
  image: `${company.url}/og/${product.slug}.png`,
};
---

<Layout
  title={product.metaTitle}
  description={product.metaDescription}
  jsonLd={jsonLd}
  ogImage={`/og/${product.slug}.png`}
  ogImageAlt={`${product.name}: ${product.oneLiner}`}
  breadcrumbs={[{ name: "Products", path: "/products/" }, { name: product.name, path: `/products/${product.slug}/` }]}
>
  <Navbar />
  <main>
    <section class="pt-16" aria-labelledby="product-heading">
      <Container className="pt-6 sm:pt-10">
        <div class:list={["tile relative overflow-hidden rounded-[28px]", `tile--${product.livery}`]}>
          <div class="px-6 pt-10 sm:px-12 sm:pt-14 lg:px-16">
            <div class="rise flex flex-wrap items-center gap-x-3 gap-y-2">
              <p class="text-lg font-semibold tracking-[-0.02em]">{product.name}</p>
              <span class:list={["inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[0.8rem] font-medium", live ? "bg-white text-ink shadow-[0_0_0_1px_rgb(var(--ink)/0.08)]" : "text-graphite shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.15)]"]}>
                {live && <span class="h-1.5 w-1.5 rounded-full bg-cobalt" aria-hidden="true"></span>}
                {live ? "Live" : "Early access"}
              </span>
              <span class="text-graphite">{product.audience}</span>
            </div>
            <h1 id="product-heading" class="rise mt-6 max-w-[16ch] text-balance font-display text-display-lg font-semibold" style="--rise-delay: 60ms">
              {product.headline.join(" ")}
            </h1>
            <p class="rise mt-5 max-w-[52ch] text-lg leading-relaxed text-graphite sm:text-xl" style="--rise-delay: 120ms">{product.summary}</p>
            {product.pricing && <p class="rise mt-4 font-medium" style="--rise-delay: 150ms">{product.pricing}</p>}
            <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-delay: 180ms">
              <BtnLink text={product.cta} href={product.ctaHref} external={ctaExternal} variant="ink" track="brand_click" trackLocation={`product_page_${product.slug}`} />
              <BtnLink text="How it works" href="#how" variant="outline" arrow={false} />
            </div>
          </div>

          <div class="rise relative mt-12 pl-6 sm:mt-16 sm:pl-12 lg:pl-16" style="--rise-delay: 240ms">
            <div class="[mask-image:linear-gradient(to_bottom,#000_78%,transparent)]">
              <ProductFrame
                src={product.screenshot}
                alt={product.screenshotAlt}
                domain={product.domain}
                eager
                className={`w-[110%] max-w-none rounded-r-none ${mobileFirst ? "lg:w-[70%]" : "lg:w-[86%]"}`}
              />
            </div>
            {mobileFirst && (
              <div class="absolute bottom-0 right-6 w-[38%] max-w-[260px] translate-y-6 sm:right-12 lg:right-16 lg:w-[24%]">
                <ProductFrame src={product.screenshotMobile} alt="" domain={product.domain} kind="mobile" />
              </div>
            )}
          </div>
        </div>
      </Container>
    </section>

    <section id="how" class="scroll-mt-20 py-20 sm:py-28" aria-labelledby="how-heading">
      <Container>
        <h2 id="how-heading" class="font-display text-display-md font-semibold">How it works</h2>
        <ol class="mt-10 grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-3">
          {product.steps.map((step, i) => (
            <li class="border-t border-ink pt-5">
              <span class="tabular text-[0.9rem] font-medium text-graphite">Step {i + 1}</span>
              <h3 class="mt-3 text-xl font-semibold tracking-[-0.02em]">{step.title}</h3>
              <p class="mt-2 max-w-[42ch] leading-relaxed text-graphite">{step.body}</p>
            </li>
          ))}
        </ol>
      </Container>
    </section>

    <section class="border-t border-line py-20 sm:py-28" aria-labelledby="features-heading">
      <Container className="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
        <h2 id="features-heading" class="font-display text-display-md font-semibold lg:col-span-5">What you get</h2>
        <ul class="grid grid-cols-1 border-t border-line sm:grid-cols-2 sm:gap-x-10 lg:col-span-7">
          {product.features.map((f) => (
            <li class="flex items-start gap-3 border-b border-line py-4 text-lg">
              <svg class="mt-1.5 h-4 w-4 shrink-0 text-cobalt" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m4 10.5 4 4 8-9" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <section class="pb-20 sm:pb-28">
      <Container>
        <div class="flex flex-col items-start justify-between gap-8 rounded-[28px] bg-paper-2 px-6 py-10 sm:px-12 sm:py-14 md:flex-row md:items-center">
          <p class="max-w-[22ch] text-balance font-display text-display-md font-semibold">{product.oneLiner}</p>
          <BtnLink text={product.cta} href={product.ctaHref} external={ctaExternal} variant="ink" track="brand_click" trackLocation={`product_page_footer_${product.slug}`} />
        </div>

        <div class="mt-20">
          <h2 class="text-lg font-semibold tracking-[-0.02em]">More from wohnmohr</h2>
          <ul class="mt-4 border-t border-line">
            {other.map((p) => (
              <li class="border-b border-line">
                <a href={`/products/${p.slug}`} class="group grid grid-cols-1 gap-1 py-5 sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-8">
                  <span class="text-xl font-semibold tracking-[-0.02em] group-hover:text-cobalt">{p.name}</span>
                  <span class="text-graphite">{p.oneLiner}</span>
                  <span class="hidden text-graphite transition-transform group-hover:translate-x-1 sm:inline" aria-hidden="true">
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
