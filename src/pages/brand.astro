---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import BtnLink from "../components/shared/BtnLink.astro";
import Container from "../components/shared/Container.astro";
import PageHero from "../components/ui/PageHero.astro";
import Logo from "../components/brand/Logo.astro";
import { products } from "../utils/company";

const colors = [
  { name: "Ink", token: "--ink", hex: "#0F1012", use: "Text and dark surfaces.", swatch: "bg-ink" },
  { name: "Paper", token: "--paper", hex: "#FBFBFA", use: "The page.", swatch: "bg-paper shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.1)]" },
  { name: "Cobalt", token: "--cobalt", hex: "#2B5BFF", use: "The one accent: actions and links. Use it for checkout and payment screens too.", swatch: "bg-cobalt" },
  { name: "Graphite", token: "--graphite", hex: "#585C64", use: "Secondary text on paper.", swatch: "bg-graphite" },
  { name: "Paper 2", token: "--paper-2", hex: "#F3F3F1", use: "Sunken sections and closing blocks.", swatch: "bg-paper-2 shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.1)]" },
  { name: "Tint", token: "--lime", hex: "#DCE5FF", use: "Pale accent for highlights and selection.", swatch: "bg-lime" },
];

const productColors = [
  { name: "Split Biller", hex: "#53307B", swatch: "bg-sb" },
  { name: "NicheLinq", hex: "#6D3ADF", swatch: "bg-nl" },
  { name: "ChargeMyAI", hex: "#0F7A4A", swatch: "bg-cma" },
  { name: "MyThreadPay", hex: "#1F2A5C", swatch: "bg-mtp" },
];

const type = [
  { name: "Display", cls: "font-display text-display-xl font-semibold", sample: "Everyday jobs.", spec: "Mona Sans 600, 42 to 88px, -4% tracking" },
  { name: "Heading", cls: "font-display text-display-md font-semibold", sample: "One job, done end to end.", spec: "Mona Sans 600, 26 to 38px, -3% tracking" },
  { name: "Body", cls: "text-lg leading-relaxed", sample: "Who owes whom in seconds. Share privately, pay over UPI.", spec: "Mona Sans 400, 18px (20px for sublines), 1.6 line height" },
  { name: "Code", cls: "font-mono text-[0.95rem]", sample: "const reply = await charge.ai.chat(text)", spec: "Geist Mono 400, for code only" },
];

const voice = [
  { say: "Split bills in ₹, settle with UPI.", not: "Revolutionise your group finance experience." },
  { say: "Nothing goes live until you publish it.", not: "Leverage AI-powered creative synergies." },
  { say: "Every piece counted. Every rupee traceable.", not: "Best-in-class holistic workforce solutions." },
];
---

<Layout title="Brand | wohnmohr" description="The wohnmohr brand: logo, colour, type, components and voice." breadcrumbs={[{ name: "Brand", path: "/brand/" }]}>
  <Navbar />
  <main>
    <PageHero
      title="Brand"
      intro="Plain, precise and product-first. Everything on this page is live code from the site; tokens live in src/styles/brand.css."
    />

    <section class="border-t border-line py-20 sm:py-24" aria-labelledby="logo-heading">
      <Container>
        <h2 id="logo-heading" class="font-display text-display-md font-semibold">Logo</h2>
        <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-graphite">
          The Continuous Fold: one ribbon whose two loops stand for building and running our products. The crossing links them, because everyday use feeds the next improvement. Keep clear space of at least one ribbon thickness around it, and never stretch, rotate or change the crossing. Below 180px wide, use the mark on its own.
        </p>
        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="grid min-h-[200px] place-items-center rounded-brand bg-white shadow-[0_0_0_1px_rgb(var(--ink)/0.08)]"><Logo size={30} /></div>
          <div class="grid min-h-[200px] place-items-center rounded-brand bg-ink"><Logo size={30} tone="light" /></div>
          <div class="grid min-h-[200px] place-items-center rounded-brand bg-paper-2"><img src="/brand/svg/app-icon-cobalt.svg" width="96" height="96" alt="wohnmohr app icon" class="h-24 w-24" /></div>
        </div>
        <p class="mt-6 text-[0.95rem] text-graphite">
          Download:
          <a href="/brand/svg/logo-horizontal-cobalt.svg" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt" download>logo (SVG)</a>,
          <a href="/brand/svg/mark-cobalt.svg" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt" download>mark (SVG)</a>,
          <a href="/brand/svg/app-icon-cobalt.svg" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt" download>app icon (SVG)</a>,
          <a href="/brand/wohnmohr-logo-dark.png" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt" download>logo (PNG)</a>.
        </p>
      </Container>
    </section>

    <section class="border-t border-line py-20 sm:py-24" aria-labelledby="color-heading">
      <Container>
        <h2 id="color-heading" class="font-display text-display-md font-semibold">Colour</h2>
        <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-graphite">Mostly ink on paper. Cobalt is the only accent. Each product keeps its own colour, used only for that product.</p>
        <ul class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {colors.map((c) => (
            <li>
              <div class={`h-28 rounded-brand ${c.swatch}`}></div>
              <p class="mt-3 font-semibold">{c.name} <span class="tabular font-normal text-graphite">{c.hex}</span></p>
              <p class="mt-1 text-[0.95rem] text-graphite"><code class="font-mono text-[0.85rem]">{c.token}</code>. {c.use}</p>
            </li>
          ))}
        </ul>
        <h3 class="mt-16 text-xl font-semibold tracking-[-0.02em]">Product colours</h3>
        <ul class="mt-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {productColors.map((c) => (
            <li class="flex items-center gap-3">
              <span class={`h-10 w-10 shrink-0 rounded-xl ${c.swatch}`}></span>
              <span><span class="block font-semibold">{c.name}</span><span class="tabular text-[0.9rem] text-graphite">{c.hex}</span></span>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <section class="border-t border-line py-20 sm:py-24" aria-labelledby="type-heading">
      <Container>
        <h2 id="type-heading" class="font-display text-display-md font-semibold">Type</h2>
        <ul class="mt-10 border-t border-line">
          {type.map((t) => (
            <li class="grid gap-3 border-b border-line py-8 lg:grid-cols-[220px_1fr] lg:items-baseline">
              <div>
                <p class="font-semibold">{t.name}</p>
                <p class="mt-1 text-[0.9rem] text-graphite">{t.spec}</p>
              </div>
              <p class={`${t.cls} break-words`}>{t.sample}</p>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <section class="border-t border-line py-20 sm:py-24" aria-labelledby="components-heading">
      <Container>
        <h2 id="components-heading" class="font-display text-display-md font-semibold">Buttons</h2>
        <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-graphite">Buttons are pills. Frames and tiles use a 16px radius. One main action per view.</p>
        <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-2">
          <div class="flex flex-wrap gap-3 rounded-brand bg-white p-8 shadow-[0_0_0_1px_rgb(var(--ink)/0.08)]">
            <BtnLink text="Primary" href="#components-heading" variant="primary" />
            <BtnLink text="Ink" href="#components-heading" variant="ink" />
            <BtnLink text="Outline" href="#components-heading" variant="outline" arrow={false} />
          </div>
          <div class="surface-ink flex flex-wrap gap-3 rounded-brand p-8">
            <BtnLink text="Bright" href="#components-heading" variant="bright" />
            <BtnLink text="Ghost" href="#components-heading" variant="ghost" arrow={false} />
          </div>
        </div>
      </Container>
    </section>

    <section class="border-t border-line py-20 sm:py-24" aria-labelledby="voice-heading">
      <Container>
        <h2 id="voice-heading" class="font-display text-display-md font-semibold">Voice</h2>
        <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-graphite">Say the job, not the jargon. Short sentences, concrete verbs, the thing people get. Lines below are from our own product sites.</p>
        <ul class="mt-10 border-t border-line">
          {voice.map((v) => (
            <li class="grid gap-2 border-b border-line py-6 sm:grid-cols-2 sm:gap-8">
              <p class="text-lg font-semibold">{v.say}</p>
              <p class="text-graphite line-through decoration-graphite/40">{v.not}</p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
