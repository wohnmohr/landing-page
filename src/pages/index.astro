---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import Hero from "../components/home/Hero.astro";
import ProductShowcase from "../components/home/ProductShowcase.astro";
import Principles from "../components/home/Principles.astro";
import Contact from "../components/home/Contact.astro";
import { company, products } from "../utils/company";

const title = `wohnmohr | ${company.tagline.replace(/\.$/, "")}`;
const description = company.shortDescription;

const productsLd = products.map((p) => ({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: p.name,
  url: p.url,
  description: p.summary,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  publisher: { "@id": `${company.url}/#organization` },
}));
---

<Layout title={title} description={description} jsonLd={productsLd}>
  <Navbar />
  <main>
    <Hero />
    <ProductShowcase />
    <Principles />
    <Contact />
  </main>
  <Footer />
</Layout>
