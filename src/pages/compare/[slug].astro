---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/elements/Navbar.astro";
import Footer from "../../components/elements/Footer.astro";
import BtnLink from "../../components/shared/BtnLink.astro";
import Container from "../../components/shared/Container.astro";
import { comparePages } from "../../utils/data";

export function getStaticPaths() {
  return comparePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <Navbar variant="overlay" />
  <main>
    <header
      class="relative overflow-hidden bg-ink pb-14 pt-32 text-white sm:pb-16 sm:pt-36"
    >
      <div class="absolute inset-0" aria-hidden="true">
        <div
          class="absolute inset-0 bg-[linear-gradient(120deg,#07111f_0%,#0a3d4a_55%,#0f9f90_100%)]"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-coral via-gold to-aqua"
        >
        </div>
      </div>
      <Container className="relative max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">
          {page.eyebrow}
        </p>
        <h1
          class="mt-3 font-display text-3xl font-semibold tracking-[-0.02em] sm:text-4xl md:text-5xl"
        >
          {page.headline}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg">
          {page.intro}
        </p>
      </Container>
    </header>

    <section class="py-14 md:py-20">
      <Container className="max-w-4xl">
        <div class="grid gap-10 md:grid-cols-2">
          <div data-reveal>
            <h2 class="font-display text-2xl font-semibold text-ink">
              {page.leftTitle}
            </h2>
            <ul class="mt-5 space-y-3">
              {
                page.leftPoints.map((point) => (
                  <li class="flex gap-3 text-base text-slate">
                    <span class="text-accent" aria-hidden="true">
                      →
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div data-reveal style="--reveal-delay: 80ms">
            <h2 class="font-display text-2xl font-semibold text-ink">
              {page.rightTitle}
            </h2>
            <ul class="mt-5 space-y-3">
              {
                page.rightPoints.map((point) => (
                  <li class="flex gap-3 text-base text-slate">
                    <span class="text-coral" aria-hidden="true">
                      →
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div
          class="mt-12 rounded-2xl border border-line bg-sand/70 px-6 py-8 sm:px-8"
          data-reveal
        >
          <h2 class="font-display text-2xl font-semibold text-ink">
            Our take
          </h2>
          <p class="mt-3 text-base leading-relaxed text-slate md:text-lg">
            {page.verdict}
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <BtnLink
              text={page.ctaLabel}
              href={page.ctaHref}
              variant="primary"
              track="compare_cta_click"
              trackLocation={page.slug}
            />
            <BtnLink
              text="Vibe-code rescue"
              href="/services/vibe-code-rescue"
              variant="secondary"
            />
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
