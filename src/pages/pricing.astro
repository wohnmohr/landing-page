---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import PricingHero from "../components/sections/PricingHero.astro";
import PricingRegions from "../components/sections/PricingRegions.astro";
import CustomPricing from "../components/sections/CustomPricing.astro";

const title =
  "Pricing | wohnmohr AI Rescue, Build, Automate & Enterprise Contact";
const description =
  "Regional startup pricing for Rescue Sprint, Build & Ship, and Automate & Assure. Enterprise AI programs: contact us for a custom quote.";
---

<Layout title={title} description={description}>
  <Navbar variant="overlay" />
  <main>
    <PricingHero />
    <PricingRegions />
    <CustomPricing />
  </main>
  <Footer />
</Layout>
