---
import "@fontsource/mona-sans/400.css";
import "@fontsource/mona-sans/500.css";
import "@fontsource/mona-sans/600.css";
import "@fontsource/mona-sans/700.css";
import "@fontsource/geist-mono/400.css";
import "../styles/brand.css";
import displayFont from "@fontsource/mona-sans/files/mona-sans-latin-600-normal.woff2?url";
import bodyFont from "@fontsource/mona-sans/files/mona-sans-latin-400-normal.woff2?url";
import { company, products } from "../utils/company";

export type Crumb = { name: string; path: string };

export interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  /** Path under /public, e.g. "/og/nichelinq.png". */
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  /** Trail below Home, e.g. [{ name: "Products", path: "/products/" }]. */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const {
  title,
  description = company.shortDescription,
  ogType = "website",
  ogImage: ogImagePath = "/og/default.png",
  ogImageAlt = `wohnmohr: ${company.tagline}`,
  jsonLd = null,
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const siteUrl = company.url;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(ogImagePath, siteUrl).href;

// Site-wide entity graph: who we are and what the site is.
const orgId = `${siteUrl}/#organization`;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: company.name,
      url: `${siteUrl}/`,
      logo: { "@type": "ImageObject", url: `${siteUrl}/logo.png`, width: 512, height: 512 },
      image: `${siteUrl}/og/default.png`,
      slogan: company.tagline,
      description: company.shortDescription,
      brand: products.map((p) => ({ "@type": "Brand", name: p.name, url: p.url })),
      foundingDate: company.founded,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        url: `${siteUrl}/#contact`,
        availableLanguage: ["English"],
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: company.name,
      publisher: { "@id": orgId },
      inLanguage: "en",
    },
  ],
};

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: new URL(c.path, siteUrl).href,
        })),
      }
    : null;
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? "";
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";

const jsonLdBlocks = [
  siteLd,
  ...(breadcrumbLd ? [breadcrumbLd] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="author" content="wohnmohr" />
    <meta name="theme-color" content="#FBFBFA" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="wohnmohr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    {
      jsonLdBlocks.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {
      posthogKey && (
        <script
          define:vars={{ posthogKey, posthogHost }}
          is:inline
        >
          !(function (t, e) {
            var o, n, p, r;
            e.__SV ||
              ((window.posthog = e),
              (e._i = []),
              (e.init = function (i, s, a) {
                function g(t, e) {
                  var o = e.split(".");
                  2 == o.length && ((t = t[o[0]]), (e = o[1])),
                    (t[e] = function () {
                      t.push(
                        [e].concat(Array.prototype.slice.call(arguments, 0))
                      );
                    });
                }
                ((p = t.createElement("script")).type = "text/javascript"),
                  (p.crossOrigin = "anonymous"),
                  (p.async = !0),
                  (p.src =
                    s.api_host.replace(".i.posthog.com", "-assets.i.posthog.com") +
                    "/static/array.js"),
                  (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(
                    p,
                    r
                  );
                var u = e;
                void 0 !== a ? (u = e[a] = []) : (a = "posthog");
                u.people = u.people || [];
                u.toString = function (t) {
                  var e = "posthog";
                  return (
                    "posthog" !== a && (e += "." + a),
                    t || (e += " (stub)"),
                    e
                  );
                };
                u.people.toString = function () {
                  return u.toString(1) + ".people (stub)";
                };
                o =
                  "init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(
                    " "
                  );
                for (n = 0; n < o.length; n++) g(u, o[n]);
                e._i.push([i, s, a]);
              }),
              (e.__SV = 1));
          })(document, window.posthog || []);
          posthog.init(posthogKey, {
            api_host: posthogHost,
            person_profiles: "identified_only",
            capture_pageview: true,
            capture_pageleave: true,
          });
        </script>
      )
    }
  </head>

  <body class="bg-paper text-ink antialiased">
    <a
      href="#contact"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-brand focus:bg-cobalt focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to contact
    </a>
    <div data-scroll-sentinel aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-6"></div>
    <slot />
  </body>

  <script>
    const toggleMenu = document.querySelector(
      "[data-toggle-nav]"
    ) as HTMLButtonElement | null;
    const navbar = document.querySelector(
      "[data-navbar]"
    ) as HTMLDivElement | null;
    const overlayNav = document.querySelector(
      "[data-nav-overlay]"
    ) as HTMLDivElement | null;

    const closeNav = () => {
      if (!toggleMenu || !navbar || !overlayNav) return;
      toggleMenu.setAttribute("data-open-nav", "false");
      toggleMenu.setAttribute("aria-expanded", "false");
      navbar.setAttribute("data-open", "false");
      overlayNav.setAttribute("data-is-visible", "false");
      document.body.classList.remove("!overflow-y-hidden");
      navbar.style.height = "0px";
    };

    if (toggleMenu && navbar && overlayNav) {
      toggleMenu.addEventListener("click", (e) => {
        e.preventDefault();
        const isClosed = toggleMenu.getAttribute("data-open-nav") === "false";
        if (isClosed) {
          toggleMenu.setAttribute("data-open-nav", "true");
          toggleMenu.setAttribute("aria-expanded", "true");
          navbar.setAttribute("data-open", "true");
          overlayNav.setAttribute("data-is-visible", "true");
          document.body.classList.add("!overflow-y-hidden");
          navbar.style.height = `${navbar.scrollHeight}px`;
        } else {
          closeNav();
        }
      });

      navbar.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest("a")) closeNav();
      });
      overlayNav.addEventListener("click", closeNav);
    }

    const year = document.getElementById("year");
    if (year) year.textContent = String(new Date().getFullYear());

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    requestAnimationFrame(() => {
      document.documentElement.classList.add("motion-ready");
    });

    // Header gets a cast shadow once the page leaves the top.
    const header = document.querySelector<HTMLElement>("[data-header]");
    const sentinel = document.querySelector<HTMLElement>("[data-scroll-sentinel]");
    if (header && sentinel && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute("data-scrolled", !entry.isIntersecting);
      }).observe(sentinel);
    }

    // Smooth in-page hash navigation (including /#contact from other pages)
    document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = (link as HTMLAnchorElement).getAttribute("href");
        if (!href) return;
        const hash = href.includes("#") ? `#${href.split("#")[1]}` : "";
        if (!hash || hash === "#") return;
        const onHome =
          window.location.pathname === "/" ||
          window.location.pathname === "/index.html";
        if (href.startsWith("/#") && !onHome) return;
        const el = document.querySelector(hash);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
        history.pushState(null, "", hash);
        closeNav();
      });
    });

    type TrackProps = Record<string, string>;

    const trackEvent = (name: string, props: TrackProps = {}) => {
      const w = window as Window & {
        posthog?: { capture: (event: string, properties?: TrackProps) => void };
      };
      if (typeof w.posthog?.capture === "function") {
        w.posthog.capture(name, props);
      }
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const el = target?.closest<HTMLElement>("[data-track]");
      if (!el) return;
      const name = el.dataset.track;
      if (!name) return;
      const props: TrackProps = {};
      if (el.dataset.trackLocation) {
        props.location = el.dataset.trackLocation;
      }
      const href = el.getAttribute("href");
      if (href) props.href = href;
      trackEvent(name, props);
    });
  </script>

</html>
