---
import Layout from "./Layout.astro";
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import BtnLink from "../components/shared/BtnLink.astro";
import Container from "../components/shared/Container.astro";
import type { BlogPost } from "../utils/blogs";
import { blogPosts } from "../utils/blogs";

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const others = blogPosts.filter((p) => p.slug !== post.slug);
const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={`${post.title} | wohnmohr`} description={post.description}>
  <Navbar variant="overlay" />
  <main>
    <article>
      <header class="relative overflow-hidden bg-ink pb-14 pt-32 text-white sm:pb-16 sm:pt-36">
        <div class="absolute inset-0" aria-hidden="true">
          <div
            class="absolute inset-0 bg-[linear-gradient(120deg,#07111f_0%,#0a3d4a_55%,#0f9f90_100%)]"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-coral via-gold to-aqua"
          >
          </div>
        </div>
        <Container className="relative max-w-3xl">
          <a
            href="/blogs"
            class="text-sm font-semibold text-white/70 transition hover:text-gold"
          >
            ← All blogs
          </a>
          <p class="mt-5 text-sm font-semibold uppercase tracking-[0.18em] text-gold">
            Blog
          </p>
          <h1
            class="mt-3 font-display text-3xl font-semibold tracking-[-0.02em] sm:text-4xl md:text-[2.6rem] md:leading-[1.15]"
          >
            {post.title}
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg">
            {post.description}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-white/65">
            <time datetime={post.date}>{formattedDate}</time>
            <span aria-hidden="true">·</span>
            <span>{post.readTime}</span>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              post.tags.map((tag) => (
                <li class="rounded-md bg-white/10 px-2.5 py-1 text-xs font-semibold text-white/85">
                  {tag}
                </li>
              ))
            }
          </ul>
        </Container>
      </header>

      <div class="py-14 md:py-20">
        <Container className="max-w-3xl">
          <div
            class="blog-prose space-y-5 text-base leading-relaxed text-slate md:text-lg"
          >
            <slot />
          </div>

          <div
            class="mt-12 rounded-2xl border border-line bg-sand/70 px-6 py-8 sm:px-8"
            data-reveal
          >
            <h2 class="font-display text-2xl font-semibold text-ink">
              Need help with this?
            </h2>
            <p class="mt-3 text-base text-slate">
              wohnmohr builds AI products, automations, and tests—and rescues
              vibe-coded projects when they go sideways.
            </p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <BtnLink
                text="Book a free intro call"
                href="/#contact"
                variant="primary"
                track="contact_cta_click"
                trackLocation="blog"
              />
              {
                post.relatedService && (
                  <BtnLink
                    text="Related service"
                    href={post.relatedService}
                    variant="secondary"
                  />
                )
              }
            </div>
          </div>

          {
            others.length > 0 && (
              <div class="mt-14" data-reveal>
                <h2 class="font-display text-2xl font-semibold text-ink">
                  More from the blog
                </h2>
                <ul class="mt-6 space-y-4">
                  {others.map((item) => (
                    <li>
                      <a
                        href={`/blogs/${item.slug}`}
                        class="hover-lift block rounded-xl border border-line bg-white px-5 py-4 transition hover:border-accent/40"
                      >
                        <p class="font-display text-lg font-semibold text-ink">
                          {item.title}
                        </p>
                        <p class="mt-1 text-sm text-slate">{item.description}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </Container>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .blog-prose h2 {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .blog-prose h3 {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .blog-prose p {
    margin: 0;
  }

  .blog-prose ul,
  .blog-prose ol {
    margin: 0.25rem 0 0.5rem;
    padding-left: 1.25rem;
  }

  .blog-prose ul {
    list-style: disc;
  }

  .blog-prose ol {
    list-style: decimal;
  }

  .blog-prose li {
    margin: 0.35rem 0;
  }

  .blog-prose strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .blog-prose a {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-prose blockquote {
    margin: 1.5rem 0;
    border-left: 4px solid var(--color-coral);
    padding-left: 1rem;
    color: var(--color-ink);
    font-style: italic;
  }
</style>
