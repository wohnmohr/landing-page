---
import Container from "../shared/Container.astro";

export interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<section class="pt-16">
  <Container className="pb-12 pt-16 sm:pb-16 sm:pt-24">
    <h1 class="rise max-w-[18ch] text-balance font-display text-display-lg font-semibold" set:html={title} />
    {intro && <p class="rise mt-6 max-w-[56ch] text-lg leading-relaxed text-graphite sm:text-xl" style="--rise-delay: 80ms">{intro}</p>}
    <slot />
  </Container>
</section>
