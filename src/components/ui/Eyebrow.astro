---
export interface Props {
  index?: string;
  tone?: "paper" | "ink";
  className?: string;
}
const { index, tone = "paper", className = "" } = Astro.props;
---

<p
  class:list={[
    "inline-flex items-center gap-2.5 font-mono text-[0.72rem] font-medium uppercase tracking-[0.14em]",
    tone === "ink" ? "text-fog" : "text-graphite",
    className,
  ]}
>
  <span
    class:list={["h-2 w-2 rounded-[2px]", tone === "ink" ? "bg-lime" : "bg-cobalt"]}
    aria-hidden="true"
  ></span>
  {index && <span class={tone === "ink" ? "text-white" : "text-ink"}>{index} /</span>}
  <slot />
</p>
