---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Logo from "../brand/Logo.astro";

export interface Props {
  /** Kept for older callers; the bar is the same on every page. */
  variant?: "overlay" | "solid";
}

const path = Astro.url.pathname;

const navItems = [
  { href: "/products", text: "Products" },
  { href: "/about", text: "About" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 bg-paper/95 text-ink supports-[backdrop-filter]:bg-paper/80 supports-[backdrop-filter]:backdrop-blur-md"
>
  <Container>
    <nav class="relative flex h-16 items-center justify-between gap-4" aria-label="Main">
      <a href="/" class="relative z-50 inline-flex h-10 items-center text-ink" aria-label="wohnmohr home">
        <Logo size={27} />
      </a>

      <ul class="hidden items-center gap-0.5 lg:flex">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "inline-flex h-10 items-center rounded-full px-3.5 text-[0.92rem] font-medium transition-colors duration-200",
                  isActive(item.href) ? "bg-ink/[0.06] text-ink" : "text-graphite hover:text-ink",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="relative z-50 flex items-center gap-2">
        <BtnLink
          text="Contact"
          href="/#contact"
          variant="ink"
          arrow={false}
          className="hidden !h-9 !px-4 !text-[0.88rem] lg:inline-flex"
          track="contact_click"
          trackLocation="navbar"
        />
        <button
          data-toggle-nav
          data-open-nav="false"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.15)] lg:hidden"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
          <span class="flex w-5 flex-col">
            <span id="line1" class="h-0.5 w-5 bg-current transition-all duration-300"></span>
            <span id="line2" class="mt-1 h-0.5 w-5 bg-current transition-all duration-300"></span>
            <span id="line3" class="mt-1 h-0.5 w-5 bg-current transition-all duration-300"></span>
          </span>
        </button>
      </div>

      <div data-nav-overlay aria-hidden="true" class="fixed inset-0 top-16 z-40 hidden bg-ink/30 lg:!hidden"></div>

      <div
        data-navbar
        data-open="false"
        class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-50 flex h-0 flex-col overflow-hidden rounded-brand bg-white text-ink shadow-[0_0_0_1px_rgb(var(--ink)/0.08),0_24px_48px_-24px_rgb(var(--ink)/0.35)] transition-[height] duration-300 ease-loop lg:hidden"
      >
        <ul class="flex flex-col px-3 pt-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center rounded-xl px-3 py-3 text-lg font-medium tracking-[-0.02em]",
                    isActive(item.href) ? "bg-ink/[0.05] text-ink" : "text-ink hover:bg-ink/[0.04]",
                  ]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="p-4">
          <BtnLink
            text="Contact"
            href="/#contact"
            variant="ink"
            arrow={false}
            className="w-full"
            track="contact_click"
            trackLocation="navbar_mobile"
          />
        </div>
      </div>
    </nav>
  </Container>
</header>
