---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Navitem from "../shared/Navitem.astro";

export interface Props {
  variant?: "overlay" | "solid";
}

const { variant = "overlay" } = Astro.props;
const isOverlay = variant === "overlay";

const navItems = [
  { href: "/#about", text: "About" },
  { href: "/#capabilities", text: "Capabilities" },
  { href: "/services/vibe-code-rescue", text: "Services" },
  { href: "/pricing", text: "Pricing" },
  { href: "/#contact", text: "Contact" },
];

const bookCallHref = "https://calendly.com/wohnmohr-contact/30min";
---

<header
  class:list={[
    "inset-x-0 top-0 z-50 py-4",
    isOverlay ? "absolute" : "sticky border-b border-line bg-mist/95 backdrop-blur",
  ]}
>
  <Container>
    <nav
      class="relative grid w-full grid-cols-[1fr_auto] items-center gap-x-4 lg:grid-cols-[1fr_auto_1fr]"
      data-nav-root
    >
      <a
        href="/"
        class="nav-animate inline-flex h-10 items-center gap-3 justify-self-start"
        style="--nav-delay: 0ms"
      >
        <img
          src="/logos/main-logo.png"
          alt="wohnmohr logo"
          width="40"
          height="40"
          class="h-10 w-10 rounded-lg object-contain"
        />
        <span
          class:list={[
            "font-display text-xl font-semibold leading-none tracking-[-0.02em]",
            isOverlay ? "text-white" : "text-ink",
          ]}
        >
          wohnmohr
        </span>
      </a>

      <!-- Desktop links -->
      <ul
        class:list={[
          "nav-animate hidden h-10 items-center justify-center gap-x-7 lg:flex",
          isOverlay ? "text-white/90" : "text-ink/80",
        ]}
        style="--nav-delay: 80ms"
      >
        {
          navItems.map((item) => (
            <Navitem {...item} overlay={isOverlay} />
          ))
        }
      </ul>

      <div
        class="nav-animate flex h-10 items-center justify-self-end gap-3"
        style="--nav-delay: 140ms"
      >
        <BtnLink
          text="Book a call"
          href={bookCallHref}
          variant="primary"
          external
          className="hidden h-10 items-center !px-5 !py-0 leading-none lg:inline-flex"
          track="calendly_click"
          trackLocation="navbar"
        />

        <button
          data-toggle-nav
          data-open-nav="false"
          class="inline-flex h-10 w-10 items-center justify-center outline-none lg:hidden"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
          <span class="flex w-6 flex-col">
            <span
              id="line1"
              class:list={[
                "h-0.5 w-6 rounded-full transition-all duration-300",
                isOverlay ? "bg-white" : "bg-ink",
              ]}
            ></span>
            <span
              id="line2"
              class:list={[
                "mt-1 h-0.5 w-6 rounded-full transition-all duration-300",
                isOverlay ? "bg-white" : "bg-ink",
              ]}
            ></span>
            <span
              id="line3"
              class:list={[
                "mt-1 h-0.5 w-6 rounded-full transition-all duration-300",
                isOverlay ? "bg-white" : "bg-ink",
              ]}
            ></span>
          </span>
        </button>
      </div>

      <!-- Mobile menu -->
      <div
        data-nav-overlay
        aria-hidden="true"
        class="fixed inset-0 z-40 hidden bg-ink/45 backdrop-blur-md lg:!hidden"
      >
      </div>

      <div
        data-navbar
        data-open="false"
        class="absolute left-0 right-0 top-full z-50 col-span-2 flex h-0 w-full flex-col overflow-hidden rounded-b-xl bg-mist shadow-lg duration-300 ease-out lg:hidden"
      >
        <ul class="flex flex-col gap-y-1 px-6 pt-5 text-ink">
          {
            navItems.map((item) => (
              <Navitem {...item} overlay={false} />
            ))
          }
        </ul>
        <div class="px-6 pb-6 pt-4">
          <BtnLink
            text="Book a call"
            href={bookCallHref}
            variant="primary"
            external
            className="w-full"
            track="calendly_click"
            trackLocation="navbar_mobile"
          />
        </div>
      </div>
    </nav>
  </Container>
</header>
