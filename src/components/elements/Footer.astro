---
import Container from "../shared/Container.astro";
import Logo from "../brand/Logo.astro";
import { company, products } from "../../utils/company";
import { servicePages } from "../../utils/data";

const columns = [
  {
    title: "Products",
    links: products.map((p) => ({ href: `/products/${p.slug}`, text: p.name })),
  },
  {
    title: "Company",
    links: [
      { href: "/company", text: "About" },
      { href: "/brand", text: "Brand & design system" },
      { href: "/blogs", text: "Journal" },
      { href: "/faq", text: "FAQ" },
    ],
  },
  {
    title: "Work with us",
    links: [
      { href: "/work-with-us", text: "How we work with teams" },
      ...servicePages.map((s) => ({ href: `/services/${s.slug}`, text: s.navLabel })),
      { href: "/pricing", text: "Pricing" },
      { href: "/tools/vibe-code-health-check", text: "Free health check" },
    ],
  },
];
---

<footer class="surface-ink relative overflow-hidden">
  <Container className="relative pt-16 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_2fr]">
      <div>
        <Logo size={26} />
        <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-fog">
          {company.tagline} Makers of {products.map((p) => p.name).join(" and ")}.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href={company.calendly} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-5 py-3 text-sm font-medium text-white transition hover:border-lime hover:text-lime" data-track="calendly_click" data-track-location="footer">
            Book a call
          </a>
          <a href={company.whatsapp} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-5 py-3 text-sm font-medium text-white transition hover:border-lime hover:text-lime" data-track="whatsapp_click" data-track-location="footer">
            WhatsApp
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-10">
        {
          columns.map((col) => (
            <div>
              <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fog">{col.title}</p>
              <ul class="mt-3 space-y-0.5 text-sm">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-block py-2 text-white/80 transition hover:text-lime">{l.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Container>

  <div class="relative mt-16 select-none overflow-hidden" aria-hidden="true">
    <p class="whitespace-nowrap text-center font-display text-[18vw] font-bold leading-[0.8] tracking-[-0.06em] text-white/[0.04]">
      wohnmohr
    </p>
  </div>

  <div class="relative border-t border-white/10">
    <Container className="flex flex-col gap-2 py-5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-fog sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; <span id="year"></span> wohnmohr</p>
      <p>Build <span class="text-cobalt-soft">→</span> Ship <span class="text-lime">→</span> Learn <span class="text-white">∞</span></p>
    </Container>
  </div>
</footer>
