---
import Container from "../shared/Container.astro";
import { servicePages } from "../../utils/data";
---

<footer class="border-t border-line bg-ink text-white" data-reveal>
  <Container className="py-12">
    <div
      class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]"
    >
      <a href="/" class="inline-flex items-start gap-3">
        <img
          src="/logos/main-logo.png"
          alt="wohnmohr logo"
          width="36"
          height="36"
          class="h-9 w-9 rounded-lg object-contain"
        />
        <div>
          <p class="font-display text-lg font-semibold tracking-[-0.02em]">
            wohnmohr
          </p>
          <p class="mt-1 text-sm text-white/65">
            AI consulting startup—build, automate, test, and rescue.
          </p>
        </div>
      </a>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">
          Company
        </p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm font-medium text-white/75">
          <a href="/#about" class="transition hover:text-gold">About</a>
          <a href="/#capabilities" class="transition hover:text-gold">Capabilities</a>
          <a href="/#faq" class="transition hover:text-gold">FAQ</a>
          <a href="/pricing" class="transition hover:text-gold">Pricing</a>
          <a href="/pricing/#enterprise" class="transition hover:text-gold">Enterprise</a>
          <a href="/#health-check" class="transition hover:text-gold">Free health check</a>
          <a href="/#contact" class="transition hover:text-gold">Contact</a>
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">
          Services
        </p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm font-medium text-white/75">
          {
            servicePages.map((s) => (
              <a
                href={`/services/${s.slug}`}
                class="transition hover:text-gold"
              >
                {s.navLabel}
              </a>
            ))
          }
          <a
            href="https://wa.me/918248438399"
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-coral"
            data-track="whatsapp_click"
            data-track-location="footer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </Container>

  <div class="border-t border-white/10 py-4">
    <Container
      className="flex flex-col gap-2 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; <span id="year"></span> wohnmohr. All rights reserved.
      </p>
      <p>AI products · Automation · Testing · Vibe-code rescue</p>
    </Container>
  </div>
</footer>
