---
import Container from "../shared/Container.astro";
import Logo from "../brand/Logo.astro";
import { company, products } from "../../utils/company";

const columns = [
  {
    title: "Products",
    links: products.map((p) => ({ href: `/products/${p.slug}`, text: p.name })),
  },
  {
    title: "Company",
    links: [
      { href: "/about", text: "About" },
      { href: "/brand", text: "Brand" },
    ],
  },
  {
    title: "Contact",
    links: [
      { href: `mailto:${company.email}`, text: "Email" },
      { href: company.whatsapp, text: "WhatsApp" },
      { href: "/#contact", text: "Write to us" },
    ],
  },
];
---

<footer class="border-t border-line bg-paper-2/60">
  <Container className="pt-14 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo size={27} />
        <p class="mt-4 max-w-xs text-[0.95rem] leading-relaxed text-graphite">
          {company.tagline} A growing suite of products we build and run ourselves.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-10">
        {
          columns.map((col) => (
            <div>
              <p class="text-[0.9rem] font-medium text-ink">{col.title}</p>
              <ul class="mt-3 space-y-0.5 text-[0.9rem]">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-block py-1.5 text-graphite transition-colors hover:text-ink">{l.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Container>

  <Container className="mt-14 flex flex-col gap-1 border-t border-line py-6 text-[0.85rem] text-graphite sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; <span id="year"></span> wohnmohr</p>
    <p>Every product listed here is one we build and run.</p>
  </Container>
</footer>
