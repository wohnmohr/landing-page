---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
---

<section
  class="relative min-h-[100svh] overflow-hidden bg-ink"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[#07111f]"></div>
    <div
      class="absolute inset-y-0 right-0 w-full animate-hero-pan bg-[linear-gradient(115deg,#07111f_0%,#07111f_38%,#0a3d4a_62%,#0f9f90_82%,#2ec4b6_100%)] lg:w-[72%]"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 hidden w-[42%] animate-hero-pan bg-[linear-gradient(160deg,rgba(255,107,53,0.92)_0%,rgba(245,166,35,0.75)_45%,rgba(46,196,182,0.2)_100%)] lg:block"
      style="animation-delay: -6s"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 h-1.5 w-full origin-left animate-accent-line bg-gradient-to-r from-coral via-gold to-aqua"
      style="animation-delay: 0.35s"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 80px 80px;"
    >
    </div>
  </div>

  <Container
    className="relative flex min-h-[100svh] flex-col justify-center pb-20 pt-28 sm:pb-24 sm:pt-32"
  >
    <div class="max-w-2xl">
      <p
        class="animate-fade-up font-display text-[2.75rem] font-semibold tracking-[-0.02em] text-white sm:text-5xl md:text-6xl"
        style="animation-delay: 0.08s"
      >
        wohnmohr
      </p>
      <h1
        id="hero-heading"
        class="mt-6 max-w-xl animate-fade-up font-display text-[1.65rem] font-medium leading-[1.2] tracking-[-0.015em] text-white sm:mt-7 sm:text-3xl md:text-[2.35rem] md:leading-[1.18]"
        style="animation-delay: 0.2s"
      >
        AI consulting that builds, automates, tests—and fixes vibe coding gone bad.
      </h1>
      <p
        class="mt-5 max-w-lg animate-fade-up font-sans text-base font-normal leading-relaxed text-white/80 sm:mt-6 sm:text-lg"
        style="animation-delay: 0.32s"
      >
        We’re an AI consulting startup. Need an AI product, automation, or solid
        testing? We do it. Prompt-built chaos that barely runs? We fix it.
      </p>
      <div
        class="mt-8 flex animate-fade-up flex-col gap-3 sm:mt-9 sm:flex-row sm:items-center"
        style="animation-delay: 0.44s"
      >
        <BtnLink
          text="Book a free intro call"
          href="#contact"
          variant="primary"
          track="contact_cta_click"
          trackLocation="hero"
        />
        <BtnLink
          text="Free health check"
          href="#health-check"
          variant="ghost"
          track="health_check_click"
          trackLocation="hero"
        />
      </div>
    </div>
  </Container>
</section>
