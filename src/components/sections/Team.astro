---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { teamBlurb } from "../../utils/data";
---

<section id="team" class="scroll-mt-24 pb-8 md:pb-12" aria-labelledby="team-heading">
  <Container>
    <div
      class="grid gap-10 rounded-2xl border border-line bg-white px-6 py-10 sm:px-10 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-12"
      data-reveal
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">
          {teamBlurb.eyebrow}
        </p>
        <Title as="h2" id="team-heading" className="mt-3">
          {teamBlurb.title}
        </Title>
        <Paragraph className="mt-4">{teamBlurb.body}</Paragraph>
      </div>
      <ul class="space-y-4">
        {
          teamBlurb.points.map((point) => (
            <li class="flex items-start gap-3 border-l-4 border-accent pl-4">
              <p class="text-base font-medium text-ink">{point}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
