---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { brands } from "../../utils/data";
---

<section
  id="products"
  class="relative scroll-mt-24 overflow-hidden py-20 md:py-28"
  aria-labelledby="products-heading"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-line to-transparent" aria-hidden="true"></div>
  <Container>
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] md:items-end" data-reveal>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">
          Our products
        </p>
        <Title as="h2" id="products-heading" className="mt-3">
          The wohnmohr family of brands
        </Title>
      </div>
      <p class="text-base leading-relaxed text-slate md:text-lg">
        We don’t just consult—we build and operate our own products. Every
        lesson from running them in production goes straight into the work we
        do for clients.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        brands.map((brand, index) => (
          <li
            id={`brand-${brand.slug}`}
            class="scroll-mt-28"
            data-reveal="scale"
            style={`--reveal-delay: ${index * 110}ms`}
          >
            <a
              href={brand.url}
              target="_blank"
              rel="noopener"
              class="brand-card group"
              style={`--c1: ${brand.colors[0]}; --c2: ${brand.colors[1]}`}
              data-spotlight
              data-tilt
              data-track="brand_click"
              data-track-location={brand.slug}
            >
              <span class="brand-card-border" aria-hidden="true" />
              <span class="brand-card-glow" aria-hidden="true" />

              <div class="relative flex items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                  {brand.logo ? (
                    <img src={brand.logo} alt="" width="56" height="56" class="h-14 w-14 rounded-2xl object-contain" loading="lazy" />
                  ) : (
                    <span class="brand-mark">{brand.mark}</span>
                  )}
                  <div>
                    <h3 class="font-display text-2xl font-semibold tracking-[-0.02em] text-white">
                      {brand.name}
                    </h3>
                    <p class="text-sm text-white/55">{brand.category}</p>
                  </div>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-white/80">
                  <span class="h-1.5 w-1.5 rounded-full" style="background: var(--c2)" />
                  {brand.status}
                </span>
              </div>

              <p class="relative mt-8 font-display text-[1.45rem] leading-snug text-white sm:text-[1.65rem]">
                {brand.tagline}
              </p>
              <p class="relative mt-3 text-[0.95rem] leading-relaxed text-white/65">
                {brand.description}
              </p>

              <ul class="relative mt-6 flex flex-wrap gap-2">
                {brand.highlights.map((h) => (
                  <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-white/75">
                    {h}
                  </li>
                ))}
              </ul>

              <div class="relative mt-8 flex items-center justify-between border-t border-white/10 pt-5 text-sm">
                <span class="font-mono text-white/50">{brand.domain}</span>
                <span class="inline-flex items-center gap-2 font-semibold text-white">
                  Visit site
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 14 14 6M7 6h7v7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }

      <li data-reveal="scale" style={`--reveal-delay: ${brands.length * 110}ms`} class="md:col-span-2">
        <a
          href="#contact"
          class="group flex flex-col items-start justify-between gap-4 rounded-3xl border border-dashed border-ink/20 bg-white/60 px-6 py-6 backdrop-blur transition hover:border-accent hover:bg-white sm:flex-row sm:items-center sm:px-8"
          data-track="contact_cta_click"
          data-track-location="products"
        >
          <div>
            <p class="font-display text-xl font-semibold text-ink">Your product could be next.</p>
            <p class="mt-1 text-sm text-slate">
              We partner with founders to build, launch, and scale new AI-first products—the same way we built ours.
            </p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition group-hover:bg-accent">
            Build with us
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </li>
    </ul>
  </Container>
</section>

<style>
  .brand-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    border-radius: 1.5rem;
    padding: 1.75rem;
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--c1) 28%, transparent), transparent 60%),
      linear-gradient(160deg, #0b1a2c 0%, #07111f 100%);
    box-shadow: 0 30px 60px -40px rgba(7, 17, 31, 0.9);
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out-soft), box-shadow 0.5s var(--ease-out-soft);
  }
  @media (min-width: 640px) {
    .brand-card { padding: 2.25rem; }
  }
  .brand-card:hover {
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--c1) 70%, transparent);
  }
  .brand-card-border {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg, color-mix(in srgb, var(--c2) 70%, transparent), rgba(255, 255, 255, 0.08) 40%, rgba(255, 255, 255, 0.04) 70%, color-mix(in srgb, var(--c1) 60%, transparent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: -1;
  }
  .brand-card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(420px circle at var(--sx, 50%) var(--sy, 0%), color-mix(in srgb, var(--c2) 22%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: -1;
  }
  .brand-card:hover .brand-card-glow { opacity: 1; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--c1), var(--c2));
    color: #07111f;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    box-shadow: 0 12px 30px -12px var(--c1), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
</style>
