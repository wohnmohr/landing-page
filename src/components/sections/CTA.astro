---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
---

<section id="contact" class="scroll-mt-24 pb-20 md:pb-28" aria-labelledby="contact-heading">
  <Container>
    <div
      class="relative overflow-hidden rounded-2xl px-6 py-12 text-white sm:px-10 md:px-14 md:py-16"
      style="background: linear-gradient(135deg, #07111f 0%, #0a3d4a 45%, #0f766e 78%, #ff6b35 140%);"
      data-reveal="scale"
    >
      <div
        class="pointer-events-none absolute -right-16 top-0 h-64 w-64 rounded-full bg-gold/40 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -left-10 bottom-0 h-56 w-56 rounded-full bg-aqua/35 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">
          Let’s talk
        </p>
        <Title as="h2" id="contact-heading" className="mt-3 text-white">
          Building AI—or stuck after vibe coding?
        </Title>
        <Paragraph className="mx-auto mt-4 max-w-xl text-white/80">
          Tell us what you’re shipping (or what’s broken). We’ll recommend a
          Rescue Sprint, Build & Ship engagement, or ongoing Automate & Assure
          support.
        </Paragraph>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <BtnLink
            text="Book a free intro call"
            href="https://calendly.com/wohnmohr-contact/30min"
            variant="bright"
            external
            className="w-full sm:w-auto"
            track="calendly_click"
            trackLocation="contact"
          />
          <BtnLink
            text="Message on WhatsApp"
            href="https://wa.me/918248438399"
            variant="ghost"
            external
            className="w-full sm:w-auto"
            track="whatsapp_click"
            trackLocation="contact"
          />
        </div>
      </div>

      <div class="relative mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-2 lg:gap-12">
        <div
          class="rounded-xl bg-white p-4 shadow-xl shadow-ink/25 sm:p-6"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          <h3 class="font-display text-lg font-bold text-ink">
            Send a quick brief
          </h3>
          <p class="mt-1 text-sm text-slate">
            Product idea, automation need, or “please fix this vibe-coded
            repo”—drop a few lines and we’ll reply.
          </p>
          <div class="mt-4">
            <iframe
              data-tally-src="https://tally.so/embed/wv4Jv0?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
              loading="lazy"
              width="100%"
              height="320"
              title="wohnmohr contact form"
              class="min-h-[280px] w-full border-0"></iframe>
          </div>
        </div>

        <div
          class="rounded-xl bg-white/10 p-2 backdrop-blur-sm sm:p-3"
          data-reveal
          style="--reveal-delay: 180ms"
        >
          <h3 class="px-3 pt-3 font-display text-lg font-bold text-white sm:px-4">
            Or pick a time
          </h3>
          <p class="px-3 pt-1 text-sm text-white/75 sm:px-4">
            30 minutes to map build, automate, test—or rescue.
          </p>
          <div
            class="calendly-inline-widget mt-2"
            data-url="https://calendly.com/wohnmohr-contact/30min"
            style="min-width:280px;height:640px;"
            role="region"
            aria-label="Calendly booking calendar"
          >
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
