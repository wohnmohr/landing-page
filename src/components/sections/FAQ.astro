---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { faqs } from "../../utils/data";
---

<section id="faq" class="scroll-mt-24 py-20 md:py-28" aria-labelledby="faq-heading">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">
        FAQ
      </p>
      <Title as="h2" id="faq-heading" className="mt-3">
        Straight answers before you book
      </Title>
      <Paragraph className="mt-4">
        Scope, ownership, timelines, and what we won’t pretend to do.{" "}
        <a
          href="/faq"
          class="font-semibold text-accent-deep underline-offset-4 hover:underline"
        >
          Full FAQ page
        </a>
      </Paragraph>
    </div>

    <div class="mx-auto mt-12 max-w-3xl space-y-3">
      {
        faqs.map((item, index) => (
          <details
            class="group rounded-xl border border-line bg-white px-5 py-4 open:shadow-[0_16px_40px_-28px_rgba(10,22,40,0.35)]"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <summary class="cursor-pointer list-none font-display text-base font-semibold text-ink marker:content-none sm:text-lg [&::-webkit-details-marker]:hidden">
              <span class="flex items-start justify-between gap-3 sm:gap-4">
                <span class="min-w-0 break-words pr-1">{item.question}</span>
                <span
                  class="shrink-0 text-accent transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate sm:text-base">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
