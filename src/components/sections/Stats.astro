---
import Container from "../shared/Container.astro";
import { stats } from "../../utils/data";
---

<section class="relative -mt-px bg-ink py-12 text-white md:py-14" aria-label="wohnmohr at a glance">
  <Container>
    <dl class="grid grid-cols-2 gap-y-8 md:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div
            class="relative px-2 text-center md:border-l md:border-white/10 md:first:border-l-0"
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <dd class="font-display text-4xl font-semibold tracking-[-0.02em] sm:text-5xl">
              <span data-count-to={stat.value}>{stat.value}</span>
              <span class="bg-gradient-to-r from-aqua to-gold bg-clip-text text-transparent">{stat.suffix}</span>
            </dd>
            <dt class="mt-2 text-xs uppercase tracking-[0.16em] text-white/55 sm:text-sm">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
