---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { techStack } from "../../utils/data";
---

<section id="stack" class="scroll-mt-24 py-20 md:py-24" aria-labelledby="stack-heading">
  <Container className="space-y-10">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">
        Stack
      </p>
      <Title as="h2" id="stack-heading" className="mt-3">
        Built with tools your team can keep
      </Title>
      <p class="mt-4 text-base text-slate md:text-lg">
        Whether we’re shipping an AI product or untangling vibe-coded output, we
        use practical stacks you can own after we hand over.
      </p>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {
        techStack.map((tech, index) => (
          <li
            class="hover-lift inline-flex items-center gap-2 rounded-xl border border-line bg-white px-4 py-3 shadow-[0_10px_24px_-20px_rgba(10,22,40,0.45)] hover:border-accent/40"
            data-reveal
            style={`--reveal-delay: ${(index % 6) * 50}ms`}
          >
            <img
              src={tech.src}
              width="100"
              height="40"
              alt={`${tech.name} logo`}
              class="h-8 w-auto sm:h-9"
              loading="lazy"
            />
            <span class="sr-only">{tech.name}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
