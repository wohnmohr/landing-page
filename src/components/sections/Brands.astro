---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { techStack } from "../../utils/data";

const loop = [...techStack, ...techStack];
---

<section id="stack" class="scroll-mt-24 py-20 md:py-24" aria-labelledby="stack-heading">
  <Container className="space-y-10">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-coral">
        Stack
      </p>
      <Title as="h2" id="stack-heading" className="mt-3">
        Built with tools your team can keep
      </Title>
      <p class="mt-4 text-base text-slate md:text-lg">
        The same practical stack powers our own products and the systems we hand
        over to clients—no lock-in, no mystery glue.
      </p>
    </div>
  </Container>

  <div class="marquee mt-10" data-reveal>
    <ul class="marquee-track">
      {
        loop.map((tech, index) => (
          <li
            class="inline-flex shrink-0 items-center gap-3 rounded-2xl border border-line bg-white px-5 py-3.5 shadow-[0_10px_24px_-20px_rgba(10,22,40,0.45)]"
            aria-hidden={index >= techStack.length ? "true" : undefined}
          >
            <img src={tech.src} width="100" height="40" alt="" class="h-8 w-auto" loading="lazy" />
            <span class="text-sm font-semibold text-ink/80">{tech.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 1rem;
    padding: 0.5rem 0;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee {
    to { transform: translateX(calc(-50% - 0.5rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .marquee-track li[aria-hidden="true"] { display: none; }
  }
</style>
