---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { packages } from "../../utils/company";

export interface Props {
  index?: string;
  compact?: boolean;
}
const { index = "04", compact = true } = Astro.props;
---

<section class="bg-paper-2 py-20 sm:py-28" aria-labelledby="work-heading">
  <Container>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-[1fr_0.8fr] md:items-end" data-reveal>
      <div>
        <Eyebrow index={index}>Work with us</Eyebrow>
        <h2 id="work-heading" class="mt-4 font-display text-display-lg font-bold">
          We also build for<br />a few teams a month.
        </h2>
      </div>
      <p class="max-w-md text-lg leading-relaxed text-graphite">
        Fixed scope, fixed end date, no hourly billing. The same loop and the same
        standards as our own products—on your problem.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        packages.map((pkg, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <a
              href={pkg.href}
              class="group flex h-full flex-col rounded-brand border border-line bg-white p-7 transition-[transform,box-shadow,border-color] duration-500 ease-loop hover:-translate-y-1 hover:border-ink/25 hover:shadow-[0_30px_60px_-40px_rgb(var(--ink)/0.5)]"
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-graphite">{pkg.duration}</span>
                <span class="grid h-9 w-9 place-items-center rounded-full bg-paper transition-colors group-hover:bg-lime">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </div>
              <h3 class="mt-8 font-display text-2xl font-bold tracking-tight">{pkg.name}</h3>
              <p class="mt-3 leading-relaxed text-graphite">{pkg.summary}</p>
              {!compact && (
                <ul class="mt-6 space-y-2 border-t border-line pt-5 text-sm">
                  {pkg.includes.map((inc) => (
                    <li class="flex gap-2"><span class="text-cobalt">→</span>{inc}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal>
      <BtnLink text="How we work with teams" href="/work-with-us" variant="ink" />
      <BtnLink text="See pricing" href="/pricing" variant="outline" arrow={false} />
    </div>
  </Container>
</section>
