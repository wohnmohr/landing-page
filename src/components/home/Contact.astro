---
import Container from "../shared/Container.astro";
import { company } from "../../utils/company";

const formSrc = `https://tally.so/embed/${company.tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---

<section id="contact" class="scroll-mt-20 pb-20 sm:pb-28" aria-labelledby="contact-heading">
  <Container>
    <div class="grid grid-cols-1 gap-10 rounded-[28px] bg-paper-2 px-6 py-12 sm:px-12 sm:py-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h2 id="contact-heading" class="max-w-[14ch] text-balance font-display text-display-lg font-semibold">Talk to the people who run them.</h2>
        <p class="mt-4 max-w-[44ch] text-lg leading-relaxed text-graphite">
          Feedback on a product, a partnership, or an interest in what we are building. A few lines is plenty.
        </p>
        <p class="mt-8 text-[0.95rem] text-graphite">
          Prefer email? <a href={`mailto:${company.email}`} class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt">{company.email}</a>
          <span class="mx-1.5" aria-hidden="true">/</span>
          <a href={company.whatsapp} target="_blank" rel="noopener noreferrer" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt" data-track="whatsapp_click" data-track-location="contact">WhatsApp</a>
        </p>
      </div>
      <div class="min-w-0 lg:col-span-7">
        <iframe
          data-tally-src={formSrc}
          loading="lazy"
          width="100%"
          height="560"
          title="Write to wohnmohr"
          class="min-h-[520px] w-full max-w-full border-0"></iframe>
      </div>
    </div>
  </Container>
</section>

<script is:inline src="https://tally.so/widgets/embed.js" defer></script>
