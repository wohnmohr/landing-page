---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Logo from "../brand/Logo.astro";
import { company } from "../../utils/company";
---

<section id="contact" class="surface-ink grain relative scroll-mt-16 overflow-hidden py-20 sm:py-28" aria-labelledby="contact-heading">
  <div class="pointer-events-none absolute left-1/2 top-0 h-[30rem] w-[50rem] -translate-x-1/2 rounded-full bg-cobalt/20 blur-[140px]" aria-hidden="true"></div>
  <Container className="relative">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <div class="flex justify-center"><Logo size={30} wordmark={false} animated /></div>
      <Eyebrow tone="ink" className="mt-8">Say hello</Eyebrow>
      <h2 id="contact-heading" class="mt-4 font-display text-display-lg font-bold">
        Got a job worth <span class="marker">looping</span> on?
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-fog">
        Feedback on our products, a partnership idea, or a build you want done
        properly—tell us in a few lines, or grab 30 minutes.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <BtnLink text="Book a 30-min call" href={company.calendly} variant="bright" external track="calendly_click" trackLocation="contact" />
        <BtnLink text="Message on WhatsApp" href={company.whatsapp} variant="ghost" external track="whatsapp_click" trackLocation="contact" />
      </div>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl gap-4 lg:grid-cols-2">
      <div class="min-w-0 rounded-brand bg-white p-5 text-ink sm:p-7" data-reveal>
        <h3 class="font-display text-xl font-bold tracking-tight">Send a quick brief</h3>
        <p class="mt-1 text-sm text-graphite">A few lines is plenty. We reply within a working day.</p>
        <div class="mt-4 min-w-0 overflow-x-clip">
          <iframe
            data-tally-src="https://tally.so/embed/wv4Jv0?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
            loading="lazy"
            width="100%"
            height="320"
            title="wohnmohr contact form"
            class="min-h-[240px] w-full max-w-full border-0 sm:min-h-[280px]"></iframe>
        </div>
      </div>
      <div class="min-w-0 rounded-brand border border-white/10 bg-ink-2 p-2 sm:p-3" data-reveal style="--reveal-delay: 100ms">
        <h3 class="px-3 pt-3 font-display text-xl font-bold tracking-tight sm:px-4">Or pick a time</h3>
        <div
          class="calendly-inline-widget mt-2"
          data-url={company.calendly}
          style="min-width:320px;height:700px;"
          role="region"
          aria-label="Calendly booking calendar"
        >
        </div>
      </div>
    </div>
  </Container>
</section>

<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
<script is:inline src="https://tally.so/widgets/embed.js" defer></script>
