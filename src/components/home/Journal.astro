---
import Container from "../shared/Container.astro";
import { blogPosts } from "../../utils/blogs";

const posts = [...blogPosts].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<section class="py-20 sm:py-28" aria-labelledby="journal-heading">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <h2 id="journal-heading" class="font-display text-display-lg font-bold">Notes from the loop.</h2>
      </div>
      <a href="/blogs" class="inline-block py-2 font-semibold text-cobalt underline decoration-cobalt/30 underline-offset-4 hover:decoration-cobalt">All posts →</a>
    </div>

    <ul class="mt-12 border-t border-line">
      {
        posts.map((post, i) => (
          <li class="border-b border-line" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <a href={`/blogs/${post.slug}`} class="group grid gap-2 py-7 transition-colors sm:grid-cols-[140px_1fr_auto] sm:items-center sm:gap-8">
              <span class="font-mono text-xs text-graphite">{fmt(post.date)}</span>
              <span>
                <span class="block font-display text-xl font-bold tracking-tight transition-colors group-hover:text-cobalt sm:text-2xl">{post.title}</span>
                <span class="mt-1 block text-sm text-graphite">{post.description}</span>
              </span>
              <span class="font-mono text-xs text-graphite">{post.readTime}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
