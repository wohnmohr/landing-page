---
import Container from "../shared/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { loop } from "../../utils/company";
---

<section class="surface-ink relative overflow-hidden py-20 sm:py-28" aria-labelledby="method-heading">
  <Container className="relative">
    <div class="grid grid-cols-1 gap-10 sm:gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <Eyebrow index="02" tone="ink">How we build</Eyebrow>
        <h2 id="method-heading" class="mt-4 font-display text-display-lg font-bold">
          Build. Ship.<br />Learn. <span class="text-lime">∞</span>
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-fog">
          Our logo isn’t decoration—it’s the operating system. Every product,
          and every client build, runs on the same loop.
        </p>
      </div>

      <ol class="space-y-4">
        {
          loop.map((stage, i) => (
            <li
              class="group relative overflow-hidden rounded-brand border border-white/10 bg-ink-2 p-7 transition-colors duration-500 hover:border-white/25 sm:p-9"
              data-reveal
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-display-sm font-bold">{stage.title}</h3>
                <span class="font-mono text-sm text-fog">{stage.index}</span>
              </div>
              <p class="mt-3 max-w-lg leading-relaxed text-fog">{stage.body}</p>
              <span
                class:list={[
                  "absolute bottom-0 left-0 h-[3px] w-full origin-left scale-x-0 transition-transform duration-700 ease-loop group-hover:scale-x-100",
                  stage.key === "build" ? "bg-cobalt" : stage.key === "ship" ? "bg-lime" : "bg-white",
                ]}
                aria-hidden="true"
              />
            </li>
          ))
        }
        <li class="flex items-center gap-3 px-2 pt-2 font-mono text-xs uppercase tracking-[0.14em] text-fog" data-reveal>
          <span class="text-lime">↺</span> Repeat, weekly.
        </li>
      </ol>
    </div>
  </Container>
</section>
