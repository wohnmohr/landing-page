---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import ProductFrame from "../brand/ProductFrame.astro";
import { products } from "../../utils/company";

const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
// One row of the real products, nothing overlapping: MyThreadPay (a desktop
// product) on the left, the three phone-first products beside it, all on one
// bottom edge. Widths are percentages so the row scales as one.
const wall = [
  { p: bySlug["split-biller"], kind: "mobile", cls: "w-[46%] sm:w-[30%] lg:w-[15%]" },
  { p: bySlug["nichelinq"], kind: "mobile", cls: "w-[46%] sm:w-[30%] lg:w-[15%]" },
  { p: bySlug["chargemyai"], kind: "mobile", cls: "w-[46%] sm:w-[30%] lg:w-[15%]" },
  { p: bySlug["mythreadpay"], kind: "desktop", cls: "w-[86%] sm:w-[64%] lg:order-first lg:w-[47.5%]" },
] as const;
---

<section class="overflow-hidden pt-16" aria-labelledby="hero-heading">
  <Container className="pt-16 sm:pt-24">
    <h1 id="hero-heading" class="rise max-w-[13ch] text-balance font-display text-display-xl font-semibold">
      Focused software for everyday jobs.
    </h1>
    <p class="rise mt-6 max-w-[40ch] text-lg leading-relaxed text-graphite sm:text-xl" style="--rise-delay: 80ms">
      We build and run products for jobs people do every week: splitting a bill, selling today's offers, paying wages.
    </p>
    <div class="rise mt-8 flex flex-wrap items-center gap-3" style="--rise-delay: 160ms">
      <BtnLink text="See the products" href="#products" variant="ink" track="products_click" trackLocation="hero" />
      <BtnLink text="How we build" href="#principles" variant="outline" arrow={false} />
    </div>
  </Container>

  <Container className="mt-14 sm:mt-16">
    <div
      class="rise -mx-4 flex snap-x snap-mandatory scroll-px-4 items-start gap-4 overflow-x-auto px-4 pb-10 sm:-mx-8 sm:scroll-px-8 sm:px-8 lg:mx-0 lg:items-end lg:gap-[2.5%] lg:overflow-visible lg:px-0 lg:pb-0"
      style="--rise-delay: 260ms"
    >
      {
        wall.map(({ p, kind, cls }, i) => (
          <a
            href={`/products/${p.slug}`}
            class:list={["block shrink-0 snap-start", cls]}
            aria-label={`${p.name}: ${p.oneLiner}`}
            data-track="product_click"
            data-track-location="hero_wall"
          >
            <ProductFrame
              src={kind === "mobile" ? p.screenshotMobile : p.screenshot}
              alt={p.screenshotAlt}
              domain={p.domain}
              kind={kind}
              eager
            />
          </a>
        ))
      }
    </div>
  </Container>
</section>
