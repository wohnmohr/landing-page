---
import Container from "../shared/Container.astro";
import { principles } from "../../utils/company";
---

<section id="principles" class="scroll-mt-20 border-t border-line py-20 sm:py-28" aria-labelledby="rules-heading">
  <Container className="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <h2 id="rules-heading" class="max-w-[12ch] font-display text-display-lg font-semibold lg:sticky lg:top-28">
        How we build.
      </h2>
    </div>
    <ol class="space-y-12 lg:col-span-8 lg:pt-2">
      {
        principles.map((p) => (
          <li class="max-w-[60ch]">
            <h3 class="text-[1.5rem] font-semibold leading-snug tracking-[-0.025em] sm:text-[1.75rem]">{p.title}.</h3>
            <p class="mt-3 text-lg leading-relaxed text-graphite">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
