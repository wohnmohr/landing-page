---
import ProductFrame from "../brand/ProductFrame.astro";
import type { Product } from "../../utils/company";

export interface Props {
  product: Product;
  /**
   * stack  : phone below the copy
   * desktop: desktop screen filling the space below the copy
   */
  layout?: "stack" | "desktop";
}

const { product: p, layout = "stack" } = Astro.props;
const live = p.status === "Live";
const external = p.ctaHref.startsWith("http");
---

<article
  class:list={[
    "tile relative flex h-full flex-col overflow-hidden",
    `tile--${p.livery}`,
  ]}
  aria-labelledby={`tile-${p.slug}`}
>
  <div class="px-6 pt-7 sm:px-9 sm:pt-9">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <h3 id={`tile-${p.slug}`} class="text-[1.15rem] font-semibold tracking-[-0.02em]">
        <a href={`/products/${p.slug}`} class="after:absolute after:inset-0 focus-visible:outline-none" data-track="product_click" data-track-location="home_tile">{p.name}</a>
      </h3>
      <span class:list={["inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[0.78rem] font-medium", live ? "bg-white text-ink shadow-[0_0_0_1px_rgb(var(--ink)/0.08)]" : "text-graphite shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.15)]"]}>
        {live && <span class="h-1.5 w-1.5 rounded-full bg-cobalt" aria-hidden="true"></span>}
        {live ? "Live" : "Early access"}
      </span>
    </div>
    <p class="mt-1 text-[0.95rem] text-graphite">{p.audience}</p>

    <p class="mt-6 max-w-[22ch] text-balance font-display text-display-sm font-semibold">{p.oneLiner}</p>
    <p class="mt-3 max-w-[46ch] text-[0.98rem] leading-relaxed text-graphite">{p.summary}</p>
    {p.pricing && <p class="mt-3 text-[0.92rem] font-medium text-ink">{p.pricing}</p>}

    <div class="relative z-10 mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem] font-medium">
      <a href={`/products/${p.slug}`} class="group/link inline-flex items-center gap-1 text-cobalt">
        How it works
        <svg class="h-4 w-4 transition-transform duration-200 group-hover/link:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a href={p.ctaHref} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="inline-flex items-center gap-1 text-ink" data-track="brand_click" data-track-location={p.slug}>
        {p.cta}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 14 14 6M7.5 6H14v6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  {
    layout === "desktop" ? (
      <div class="relative mt-9 min-h-[15rem] flex-1 sm:min-h-[20rem] lg:min-h-[16rem]" aria-hidden="true">
        <ProductFrame
          src={p.screenshot}
          alt=""
          domain={p.domain}
          fill
          className="absolute -bottom-10 -right-10 left-6 top-0 rounded-r-none sm:left-9"
        />
      </div>
    ) : (
      <div class="mt-auto flex justify-center px-6 pt-9" aria-hidden="true">
        <ProductFrame
          src={p.screenshotMobile}
          alt=""
          domain={p.domain}
          kind="mobile"
          className="-mb-28 w-[64%] min-w-[200px] max-w-[250px]"
        />
      </div>
    )
  }
</article>
