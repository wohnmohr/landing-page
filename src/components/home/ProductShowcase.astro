---
import Container from "../shared/Container.astro";
import ProductTile from "./ProductTile.astro";
import { products } from "../../utils/company";

export interface Props {
  showIntro?: boolean;
}
const { showIntro = true } = Astro.props;

// Two phone tiles side by side, then a narrow phone tile beside the wide desktop
// tile. Phone-first products are shown on a phone; desktop products on a desktop screen.
const spans = ["lg:col-span-6", "lg:col-span-6", "lg:col-span-5", "lg:col-span-7"];
---

<section id="products" class="scroll-mt-20 py-20 sm:py-28" aria-labelledby="products-heading">
  <Container>
    {
      showIntro ? (
        <h2 id="products-heading" class="max-w-[20ch] text-balance font-display text-display-lg font-semibold">
          Our products. Each one does one job.
        </h2>
      ) : (
        <h2 id="products-heading" class="sr-only">Products</h2>
      )
    }

    <div class:list={["grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5", showIntro && "mt-12 sm:mt-14"]}>
      {
        products.map((p, i) => {
          const span = spans[i % spans.length];
          const layout = p.device === "desktop" ? "desktop" : "stack";
          return (
            <div class={span}>
              <ProductTile product={p} layout={layout} />
            </div>
          );
        })
      }
    </div>

    <p class="mt-10 max-w-[60ch] text-lg leading-relaxed text-graphite">
      More are on the way, each built to make an everyday job easier for ordinary people.
      <a href="/about" class="text-cobalt underline decoration-cobalt/30 hover:decoration-cobalt">Why we build them</a>
    </p>
  </Container>
</section>
