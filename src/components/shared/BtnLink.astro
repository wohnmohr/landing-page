---
export interface Props {
  href: string;
  text: string;
  className?: string;
  /**
   * primary, cobalt, the main action on paper
   * bright, white, the main action on ink
   * secondary, white, on ink or a tinted surface
   * ghost, outline, on ink
   * outline, outline, on paper
   * ink, solid ink, on paper
   */
  variant?: "primary" | "secondary" | "ghost" | "bright" | "outline" | "ink";
  external?: boolean;
  arrow?: boolean;
  track?: string;
  trackLocation?: string;
}

const {
  href,
  text,
  className = "",
  variant = "primary",
  external = false,
  arrow = true,
  track,
  trackLocation,
} = Astro.props;

const styles = {
  primary: "bg-cobalt text-white hover:bg-cobalt-deep",
  bright: "bg-white text-ink hover:bg-white/85",
  secondary: "bg-white text-ink shadow-[0_0_0_1px_rgb(var(--ink)/0.1)] hover:bg-paper-2",
  ghost: "shadow-[inset_0_0_0_1px_rgb(255_255_255/0.3)] text-white hover:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.7)]",
  outline: "shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.18)] text-ink hover:shadow-[inset_0_0_0_1px_rgb(var(--ink)/0.5)]",
  ink: "bg-ink text-white hover:bg-ink-3",
};

const classes = `group/btn inline-flex h-11 max-w-full items-center justify-center gap-1.5 whitespace-nowrap rounded-full px-5 text-center text-[0.95rem] font-medium tracking-[-0.01em] transition-[background-color,box-shadow,color,transform] duration-200 ease-loop active:scale-[0.98] ${styles[variant]} ${className}`;

const trackAttrs = track
  ? {
      "data-track": track,
      ...(trackLocation ? { "data-track-location": trackLocation } : {}),
    }
  : {};
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a href={href} class={classes} {...externalAttrs} {...trackAttrs}>
  <span>{text}</span>
  {
    arrow && (
      <svg class="h-4 w-4 shrink-0 transition-transform duration-200 ease-loop group-hover/btn:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        {external ? (
          <path d="M6 14 14 6M7.5 6H14v6.5" stroke-linecap="round" stroke-linejoin="round" />
        ) : (
          <path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        )}
      </svg>
    )
  }
</a>
