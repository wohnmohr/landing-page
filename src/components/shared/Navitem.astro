---
export interface Props {
  href: string;
  text: string;
  overlay?: boolean;
}
const { href, text, overlay = true } = Astro.props;
---

<li class="flex items-center">
  <a
    href={href}
    class:list={[
      "relative inline-flex items-center py-2.5 text-base font-medium leading-none transition duration-300 after:absolute after:bottom-1 after:left-0 after:h-px after:w-0 after:bg-current after:transition-all after:duration-300 hover:after:w-full lg:h-10 lg:py-0 lg:after:bottom-2",
      overlay
        ? "text-ink/80 hover:text-accent lg:text-white/85 lg:hover:text-white"
        : "text-ink/80 hover:text-accent",
    ]}
  >
    {text}
  </a>
</li>
