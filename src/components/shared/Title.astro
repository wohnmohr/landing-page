---
export interface Props {
  as?: "h1" | "h2" | "h3";
  className?: string;
  id?: string;
}

const { as: Tag = "h2", className = "", id } = Astro.props;
---

<Tag
  id={id}
  class={`text-balance break-words font-display text-display-md font-bold ${className.includes("text-") ? "" : "text-ink"} ${className}`}
>
  <slot />
</Tag>
