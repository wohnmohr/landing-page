---
/** A real product screenshot in a quiet frame, labelled with the product's domain. */
export interface Props {
  src: string;
  alt: string;
  domain: string;
  /** desktop: 1440x900 viewport at 2x. mobile: 390x750 viewport at 2x. */
  kind?: "desktop" | "mobile";
  /** Stretch to the parent's height (image crops from the top). */
  fill?: boolean;
  eager?: boolean;
  className?: string;
}

const { src, alt, domain, kind = "desktop", eager = false, fill = false, className = "" } = Astro.props;
const mobile = kind === "mobile";
---

<figure class={`frame ${mobile ? "rounded-[22px]" : ""} ${fill ? "flex h-full flex-col" : ""} ${className}`}>
  <figcaption class:list={["flex items-center justify-center border-b border-line bg-paper-2/70 text-[0.72rem] font-medium text-graphite", mobile ? "h-7" : "h-8"]}>
    {domain}
  </figcaption>
  <img
    src={src}
    alt={alt}
    width={mobile ? 780 : 2400}
    height={mobile ? 1500 : 1500}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class:list={["block w-full object-cover object-top", fill ? "min-h-0 flex-1" : mobile ? "aspect-[52/100]" : "aspect-[16/10]"]}
  />
</figure>
