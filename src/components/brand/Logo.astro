---
/**
 * The wohnmohr logo: "The Continuous Fold". One ribbon whose two loops stand for
 * building and running products; the over-under crossing links them.
 * Geometry and the outlined wordmark come from the brand bundle (public/brand/svg/).
 *
 * tone  color: cobalt mark, ink wordmark (light backgrounds)
 *       light: white mark and wordmark (cobalt or ink backgrounds)
 *       dark:  ink mark and wordmark
 * size  height of the mark in px; the wordmark scales with it.
 */
export interface Props {
  size?: number;
  tone?: "color" | "light" | "dark";
  wordmark?: boolean;
  /** Accepted for older callers and ignored. */
  animated?: boolean;
  className?: string;
  label?: string;
}

const { size = 20, tone = "color", wordmark = true, className = "", label = "wohnmohr" } = Astro.props;

const markColor = { color: "#2B5BFF", light: "#fff", dark: "#0F1012" }[tone];
const wordColor = { color: "#0F1012", light: "#fff", dark: "#0F1012" }[tone];
const uid = `fold-${Math.random().toString(36).slice(2, 8)}`;

const loop = "M350 155 L246 65 Q226 45 197 45 H165 C102 45 55 91 55 155 C55 219 102 265 165 265 H197 Q226 265 246 245 L454 65 Q474 45 503 45 H535 C598 45 645 91 645 155 C645 219 598 265 535 265 H503 Q474 265 454 245 Z";
const over = "M275 90.1 L425 219.9";
const knock = "M289 102.2 L411 207.8";

// Lockup canvas is the bundle's 854x200 horizontal logo; the mark sits at translate(25 38) scale(.4) (124px tall).
const lockupH = size * (200 / 124);
const lockupW = lockupH * (854 / 200);
const markW = size * (700 / 310);
---

{
  wordmark ? (
    <svg class={className} width={lockupW} height={lockupH} viewBox="0 0 854 200" role="img" aria-label={label}>
      <g transform="translate(25 38) scale(.4)">
        <defs>
          <mask id={uid} maskUnits="userSpaceOnUse" x="0" y="0" width="700" height="310">
            <rect width="700" height="310" fill="white" />
            <path d={knock} fill="none" stroke="black" stroke-width="90" />
          </mask>
        </defs>
        <g fill="none" stroke={markColor} stroke-width="70" stroke-linejoin="round">
          <path d={loop} mask={`url(#${uid})`} />
          <path d={over} />
        </g>
      </g>
      <g style={`color:${wordColor}`}>
        <Fragment set:html={`<g transform="translate(335 141)"><g fill="currentColor"><path d="M61.30 0.0 76.60 -54.0H62.1L53.90 -16.2L45.80 -54.0H31.8L23.6 -16.2L15.0 -54.0H0.5L15.70 0.0H30.1L38.7 -38.1L46.80 0.0Z"/><path d="M105.10 -54.90C88.60 -54.90 78.50 -44.0 78.50 -26.3C78.50 -8.5 88.60 2.30 105.20 2.30C121.70 2.30 131.90 -8.5 131.90 -25.90C131.90 -44.2 122.00 -54.90 105.10 -54.90ZM105.20 -43.6C112.9 -43.6 117.90 -36.7 117.90 -26.1C117.90 -16.0 112.70 -9.0 105.20 -9.0C97.60 -9.0 92.50 -15.9 92.50 -26.3C92.50 -36.7 97.60 -43.6 105.20 -43.6Z"/><path d="M140.0 -72.9V0.0H154.0V-32.4C154.0 -38.6 158.5 -43.0 164.8 -43.0C167.9 -43.0 170.20 -41.90 171.8 -39.7C173.10 -37.9 173.4 -36.4 173.4 -33.0V0.0H187.4V-36.2C187.4 -42.90 185.60 -47.7 181.9 -50.80C178.8 -53.40 174.3 -54.90 169.8 -54.90C162.9 -54.90 157.9 -52.2 154.0 -46.2V-72.9Z"/><path d="M197.90 -54.0V0.0H211.90V-32.4C211.90 -38.80 216.3 -43.0 223.20 -43.0C229.20 -43.0 232.20 -39.7 232.20 -33.30V0.0H246.20V-36.2C246.20 -48.2 239.70 -54.90 228.10 -54.90C220.8 -54.90 215.90 -52.30 211.90 -46.2V-54.0Z"/><path d="M255.90 -54.0V0.0H269.90V-32.4C269.90 -39.1 273.50 -43.0 279.50 -43.0C284.20 -43.0 287.1 -40.30 287.1 -36.0V0.0H301.1V-32.4C301.1 -39.0 304.70 -43.0 310.70 -43.0C315.40 -43.0 318.30 -40.30 318.30 -36.0V0.0H332.30V-38.2C332.30 -48.7 325.90 -54.90 315.1 -54.90C308.20 -54.90 303.50 -52.5 299.30 -46.90C296.70 -52.0 291.30 -54.90 284.6 -54.90C278.40 -54.90 274.40 -52.90 269.8 -47.30V-54.0Z"/><path d="M366.10 -54.90C349.60 -54.90 339.50 -44.0 339.50 -26.3C339.50 -8.5 349.60 2.30 366.20 2.30C382.70 2.30 392.90 -8.5 392.90 -25.90C392.90 -44.2 383.00 -54.90 366.10 -54.90ZM366.20 -43.6C373.90 -43.6 378.90 -36.7 378.90 -26.1C378.90 -16.0 373.70 -9.0 366.20 -9.0C358.60 -9.0 353.50 -15.9 353.50 -26.3C353.50 -36.7 358.60 -43.6 366.20 -43.6Z"/><path d="M401.00 -72.9V0.0H415.00V-32.4C415.00 -38.6 419.50 -43.0 425.80 -43.0C428.90 -43.0 431.20 -41.90 432.80 -39.7C434.10 -37.9 434.40 -36.4 434.40 -33.0V0.0H448.40V-36.2C448.40 -42.90 446.60 -47.7 442.90 -50.80C439.80 -53.40 435.30 -54.90 430.80 -54.90C423.90 -54.90 418.90 -52.2 415.00 -46.2V-72.9Z"/><path d="M458.90 -54.0V0.0H472.90V-28.70C472.90 -36.9 477.00 -41.0 485.20 -41.0C486.70 -41.0 487.70 -40.90 489.60 -40.6V-54.80C488.80 -54.90 488.50 -54.90 487.90 -54.90C481.50 -54.90 476.00 -50.7 472.90 -43.40V-54.0Z"/></g></g>`} />
      </g>
    </svg>
  ) : (
    <svg class={className} width={markW} height={size} viewBox="0 0 700 310" role="img" aria-label={label}>
      <defs>
        <mask id={uid} maskUnits="userSpaceOnUse" x="0" y="0" width="700" height="310">
          <rect width="700" height="310" fill="white" />
          <path d={knock} fill="none" stroke="black" stroke-width="90" />
        </mask>
      </defs>
      <g fill="none" stroke={markColor} stroke-width="70" stroke-linejoin="round">
        <path d={loop} mask={`url(#${uid})`} />
        <path d={over} />
      </g>
    </svg>
  )
}
